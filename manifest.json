{
  "manifest_version": 3,
  "name": "ChatGPT Archive for Obsidian",
  "version": "0.3.2",
  "description": "Materializes virtualized ChatGPT turns, preserves authenticated chat images, and prepares callout-safe content for Obsidian Web Clipper.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
